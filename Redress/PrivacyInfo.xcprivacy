<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Redress collects nothing and tracks nothing. Claims and documents
	     live on-device only (SwiftData + file-protected local storage);
	     the only network calls a paying user's device makes are to Apple's
	     own StoreKit servers and, at the user's own tap, directly to the
	     official settlement administrator's site. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: app reads/writes only its own preferences (onboarding flag). -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
